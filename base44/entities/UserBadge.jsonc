{
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "user_name": {
      "type": "string",
      "title": "User Name"
    },
    "badge_name": {
      "type": "string",
      "title": "Badge Name"
    },
    "badge_icon_key": {
      "type": "string",
      "title": "Badge Icon Key"
    }
  },
  "required": [
    "user_id",
    "badge_name"
  ],
  "name": "UserBadge",
  "type": "object",
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}