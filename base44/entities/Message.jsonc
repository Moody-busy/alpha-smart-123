{
  "properties": {
    "text": {
      "type": "string",
      "title": "Text"
    },
    "user_name": {
      "type": "string",
      "title": "User Name"
    },
    "user_role": {
      "type": "string",
      "title": "User Role",
      "enum": [
        "Student",
        "Teacher"
      ]
    },
    "has_pioneer_badge": {
      "type": "boolean",
      "title": "Has Pioneer Badge",
      "default": false
    }
  },
  "required": [
    "text",
    "user_name",
    "user_role"
  ],
  "name": "Message",
  "type": "object",
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}