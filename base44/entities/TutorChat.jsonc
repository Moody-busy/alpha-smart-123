{
  "name": "TutorChat",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "Member ID"
    },
    "user_name": {
      "type": "string",
      "title": "Member Name"
    },
    "user_email": {
      "type": "string",
      "title": "Member Email"
    },
    "account_type": {
      "type": "string",
      "title": "Member Type"
    },
    "question": {
      "type": "string",
      "title": "Question"
    },
    "answer": {
      "type": "string",
      "title": "Alpha Tutor Answer"
    }
  },
  "required": [
    "user_id",
    "question",
    "answer"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}