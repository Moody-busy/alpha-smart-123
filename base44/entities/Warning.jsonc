{
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "user_name": {
      "type": "string",
      "title": "Member Name"
    },
    "user_email": {
      "type": "string",
      "title": "Member Email"
    },
    "reason": {
      "type": "string",
      "title": "Reason"
    },
    "issued_by_name": {
      "type": "string",
      "title": "Issued By"
    },
    "acknowledged": {
      "type": "boolean",
      "title": "Acknowledged",
      "default": false
    },
    "acknowledged_date": {
      "type": "string",
      "format": "date-time",
      "title": "Acknowledged Date"
    }
  },
  "required": [
    "user_id",
    "reason"
  ],
  "name": "Warning",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}